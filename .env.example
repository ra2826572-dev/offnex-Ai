# IMAGE_GENERATION_API_KEY: API key for Cloud AI image generation.
# Falls back to GEMINI_API_KEY if IMAGE_GENERATION_API_KEY is not set.
IMAGE_GENERATION_API_KEY="MY_IMAGE_GENERATION_API_KEY"

# IMAGE_GENERATION_MODEL: Server-side Gemini image generation model ID.
IMAGE_GENERATION_MODEL="gemini-3.1-flash-lite-image"

# GEMINI_API_KEY: Required for Gemini AI text and fallback image generation API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional URL for a compatible local Stable Diffusion WebUI (--api) server
LOCAL_SD_URL="http://127.0.0.1:7860"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"